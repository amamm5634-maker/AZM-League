# انسخ هذا الملف باسم .env.local واملأ القيم من Supabase → زر Connect (أو Project Settings → API Keys).
# VITE_SUPABASE_ANON_KEY: ضع فيه الـ Publishable key (يبدأ بـ sb_publishable_) — أو الـ anon key القديم.
# لا تضع Secret key (sb_secret_) ولا service_role key هنا أبداً.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
